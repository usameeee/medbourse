# MEDBOURSE — copy to .env (never commit .env)

# API
NODE_ENV=development
API_PORT=4000
# Hosting platforms (Render, Railway, Heroku) inject PORT; the API honors it as a fallback
# when API_PORT is unset.
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/medbourse?retryWrites=true&w=majority

# Auth (generate strong random values for production)
JWT_SECRET=change-me-use-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=change-me-use-long-random-string
# Cookie SameSite policy: lax (same-domain / reverse-proxy) or none (web and API on
# different registrable domains, e.g. Vercel web + Render API). `none` requires HTTPS
# and NODE_ENV=production so the cookie is also `secure`.
COOKIE_SAMESITE=lax

# File storage: memory (tests) | local (dev without Cloudinary) | cloudinary
STORAGE_DRIVER=local

# Cloudinary (private folder for sensitive docs; public folder for marketing images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_SENSITIVE=medbourse/private
CLOUDINARY_FOLDER_PUBLIC=medbourse/public

# Email — Gmail SMTP (see docs/EMAIL.md). With SMTP_USER + SMTP_PASS set, mail is really
# sent; leave them blank and the API falls back to dev mode (logs intent only, sends nothing).
# Use a Google App Password, not the Gmail login password.
# Create at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=
EMAIL_FROM="MEDBOURSE <your-account@gmail.com>"

# Web (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
