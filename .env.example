# MEDBOURSE — copy to .env (never commit .env)

# API
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/medbourse?retryWrites=true&w=majority

# Auth (generate strong random values for production)
JWT_SECRET=change-me-use-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=change-me-use-long-random-string

# File storage: memory (tests) | local (dev without Cloudinary) | cloudinary
STORAGE_DRIVER=local

# Cloudinary (sensitive docs use private folders)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_SENSITIVE=medbourse/private

# Email — Gmail SMTP (planned). Dev mode logs intent only and does not send (see docs/EMAIL.md).
# Use a Google App Password, not the Gmail login password.
# Create at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=
EMAIL_FROM="MEDBOURSE <your-account@gmail.com>"

# Web (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
