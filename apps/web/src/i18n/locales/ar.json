  "faqPage": {
    "eyebrow": "الدعم",
    "title": "الأسئلة الشائعة",
    "lead": "إجابات سريعة حول الدراسة والعلاج والسفر في تركيا — وكيف يعمل ملفك.",
    "items": {
      "q1": "ما الذي تقوم به medbourse فعليًا؟",
      "a1": "ننسّق ثلاثة خدمات مترابطة في تركيا: القبول الجامعي، والاستشارة الطبية وتخطيط العلاج، والسفر حول مواعيدك. ويمر كل شيء عبر ملف واحد يديره فريق واحد.",
      "q2": "هل معلوماتي الشخصية والطبية آمنة؟",
      "a2": "نعم. تُخزَّن مستندات الهوية والملفات الطبية في مساحة خاصة، ولا يمكن الوصول إليها إلا لأعضاء الفريق المُسنَدين إلى ملفك. ولا نبيع بياناتك أبدًا.",
      "q3": "هل أحتاج إلى حساب للبدء؟",
      "a3": "يتيح لك الحساب فتح ملف ومتابعة تقدّمه، ويمكنك إنشاؤه في دقيقة واحدة؛ فهو يحفظ مستنداتك ورسائلك في مكان خاص واحد.",
      "q4": "كيف تُدار التكاليف؟",
      "a4": "بعد مراجعة ملفك، تتلقى عرضًا سعريًا مكتوبًا بالمبالغ الدقيقة. العروض لحظات ثابتة، لذا فالسعر المعروض هو السعر المطبَّق على ذلك العرض.",
      "q5": "ما اللغات المتاحة؟",
      "a5": "المنصة متاحة بالإنجليزية والتركية والفرنسية والعربية. يمكنك تبديل اللغة في أي وقت من أعلى الصفحة.",
      "q6": "كيف أتواصل مع الفريق؟",
      "a6": "استخدم صفحة التواصل للوصول إلينا، أو سجّل الدخول إلى ملفك لإرسال رسالة مباشرة إلى الفريق الذي يتولّاه."
    }
  },
  "privacyPage": {
    "eyebrow": "قانوني",
    "title": "سياسة الخصوصية",
    "lead": "كيف تجمع medbourse معلوماتك وتستخدمها وتحميها.",
    "updated": "آخر تحديث: {{date}}",
    "sections": {
      "dataWeCollect": {
        "title": "المعلومات التي نجمعها",
        "body": "نجمع المعلومات التي تقدّمها عند إنشاء حساب أو فتح ملف — مثل اسمك وبيانات التواصل والمستندات التي ترفعها. كما نسجّل المعلومات التقنية اللازمة لتشغيل الخدمة بشكل آمن."
      },
      "howWeUse": {
        "title": "كيف نستخدم معلوماتك",
        "body": "تُستخدم معلوماتك لتقييم ملفك وتنسيقه، والتواصل معك، والاحتفاظ بسجل للقرارات. ولا نستخدمها لأغراض غير مرتبطة بالخدمات التي طلبتها."
      },
      "sensitiveData": {
        "title": "المستندات الحساسة",
        "body": "تُعتبر مستندات الهوية والملفات الطبية حساسة. تُخزَّن بشكل خاص، ولا يصل إليها إلا أعضاء الفريق المُسنَدون إلى ملفك، وتُشارك مع المؤسسات الشريكة فقط عند الحاجة لتقديم الخدمة التي طلبتها."
      },
      "dataSharing": {
        "title": "المشاركة",
        "body": "لا نشارك المعلومات إلا مع الشركاء اللازمين لإنجاز ملفك — كجامعة أو عيادة أو مزوّد سفر — وبالتفاصيل المتعلقة بتلك الخطوة فقط. ولا نبيع البيانات الشخصية."
      },
      "retention": {
        "title": "الاحتفاظ",
        "body": "نحتفظ بمعلوماتك ما دام ملفك نشطًا، وللمدة التي يفرضها القانون أو التزاماتنا بسجلاتنا بعد ذلك، ثم تُحذف أو تُجهَّل."
      },
      "rights": {
        "title": "حقوقك",
        "body": "يمكنك طلب الوصول إلى بياناتك الشخصية أو تصحيحها أو حذفها، وفقًا للمتطلبات القانونية. لممارسة هذه الحقوق، تواصل معنا عبر البيانات أدناه."
      },
      "cookies": {
        "title": "ملفات تعريف الارتباط والتخزين المحلي",
        "body": "نستخدم التخزين المحلي لتذكّر تفضيلات اللغة والمظهر. وهي وظيفية فقط ولا تُستخدم للإعلانات."
      },
      "contact": {
        "title": "التواصل",
        "body": "لأي سؤال أو طلب يتعلق بالخصوصية، تواصل معنا عبر صفحة التواصل."
      }
    }
  },
