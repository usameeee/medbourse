  "faqPage": {
    "eyebrow": "Destek",
    "title": "Sıkça sorulan sorular",
    "lead": "Türkiye'de eğitim, tedavi ve seyahat — ve vakanızın nasıl işlediği hakkında hızlı yanıtlar.",
    "items": {
      "q1": "medbourse tam olarak ne yapar?",
      "a1": "Türkiye'de birbiriyle bağlantılı üç hizmeti koordine ediyoruz: üniversite kabulleri, sağlık danışmanlığı ve tedavi planlaması ile randevularınız çevresindeki seyahat. Her şey tek bir ekip tarafından yürütülen tek bir vaka üzerinden ilerler.",
      "q2": "Kişisel ve tıbbi bilgilerim güvende mi?",
      "a2": "Evet. Kimlik ve tıbbi belgeler özel bir depolamada saklanır ve yalnızca vakanıza atanmış ekip üyeleri erişebilir. Verilerinizi hiçbir zaman satmayız.",
      "q3": "Başlamak için hesaba ihtiyacım var mı?",
      "a3": "Bir hesap, vaka açmanıza ve ilerlemesini takip etmenize olanak tanır. Bir dakika içinde oluşturabilirsiniz; belgelerinizi ve mesajlarınızı tek bir özel yerde tutar.",
      "q4": "Maliyetler nasıl yönetilir?",
      "a4": "Vakanız incelendikten sonra tam tutarları içeren yazılı bir teklif alırsınız. Teklifler sabit anlık görüntülerdir; yani size gösterilen fiyat o teklif için geçerli olan fiyattır.",
      "q5": "Hangi dilleri kullanabilirim?",
      "a5": "Platform İngilizce, Türkçe, Fransızca ve Arapça olarak kullanılabilir. Dili sayfanın üst kısmından istediğiniz zaman değiştirebilirsiniz.",
      "q6": "Ekiple nasıl iletişime geçerim?",
      "a6": "Bize ulaşmak için iletişim sayfasını kullanın veya vakanıza giriş yaparak doğrudan ilgilenen ekibe mesaj gönderin."
    }
  },
  "privacyPage": {
    "eyebrow": "Hukuki",
    "title": "Gizlilik politikası",
    "lead": "medbourse bilgilerinizi nasıl toplar, kullanır ve korur.",
    "updated": "Son güncelleme: {{date}}",
    "sections": {
      "dataWeCollect": {
        "title": "Topladığımız bilgiler",
        "body": "Hesap oluşturduğunuzda veya bir vaka açtığınızda sağladığınız bilgileri toplarız — adınız, iletişim bilgileriniz ve yüklediğiniz belgeler gibi. Ayrıca hizmeti güvenli biçimde işletmek için gereken teknik bilgileri kaydederiz."
      },
      "howWeUse": {
        "title": "Bilgilerinizi nasıl kullanıyoruz",
        "body": "Bilgileriniz vakanızı değerlendirmek ve koordine etmek, sizinle iletişim kurmak ve kararların kaydını tutmak için kullanılır. Talep ettiğiniz hizmetlerle ilgisiz amaçlarla kullanılmaz."
      },
      "sensitiveData": {
        "title": "Hassas belgeler",
        "body": "Kimlik ve tıbbi belgeler hassas kabul edilir. Gizli olarak saklanır, yalnızca vakanıza atanmış ekip üyeleri erişebilir ve yalnızca istediğiniz hizmeti sunmak için gerekli olduğunda ortak kurumlarla paylaşılır."
      },
      "dataSharing": {
        "title": "Paylaşım",
        "body": "Bilgileri yalnızca vakanızı yerine getirmek için gereken ortaklarla — örneğin bir üniversite, klinik veya seyahat sağlayıcısı — ve yalnızca o adımla ilgili ayrıntılarla paylaşırız. Kişisel verileri satmayız."
      },
      "retention": {
        "title": "Saklama",
        "body": "Bilgilerinizi vakanız aktif olduğu sürece ve sonrasında yasaların veya kayıt tutma yükümlülüklerimizin gerektirdiği süre boyunca saklarız; ardından silinir veya anonim hâle getirilir."
      },
      "rights": {
        "title": "Haklarınız",
        "body": "Yasal gereklilikler saklı kalmak kaydıyla, kişisel verilerinize erişim, düzeltme veya silme talep edebilirsiniz. Bu hakları kullanmak için aşağıdaki bilgilerden bize ulaşın."
      },
      "cookies": {
        "title": "Çerezler ve yerel depolama",
        "body": "Dil ve tema tercihlerinizi hatırlamak için yerel depolama kullanırız. Bunlar yalnızca işlevseldir ve reklam amaçlı kullanılmaz."
      },
      "contact": {
        "title": "İletişim",
        "body": "Gizlilikle ilgili her türlü soru veya talep için iletişim sayfasından bize ulaşın."
      }
    }
  },
  "termsPage": {
    "eyebrow": "Hukuki",
    "title": "Kullanım şartları",
    "lead": "medbourse'u kullandığınızda geçerli olan şartlar.",
    "updated": "Son güncelleme: {{date}}",
    "sections": {
      "acceptance": {
        "title": "Bu şartların kabulü",
        "body": "Bir hesap oluşturarak veya medbourse'u kullanarak bu şartları kabul etmiş olursunuz. Kabul etmiyorsanız lütfen hizmeti kullanmayın."
      },
      "services": {
        "title": "Hizmet",
        "body": "medbourse, Türkiye'de eğitim, sağlık ve seyahat hizmetleri için koordinasyon sağlar. Aracı ve kolaylaştırıcı olarak hareket ederiz; nihai kabul, tedavi ve seyahat kararları ilgili kurum ve sağlayıcılara aittir."
      },
      "accounts": {
        "title": "Hesaplar",
        "body": "Sağladığınız bilgilerin doğruluğundan ve hesap bilgilerinizin güvenliğinden siz sorumlusunuz. Bu sözleşmeyi yapmaya yasal olarak ehil olmalısınız."
      },
      "quotations": {
        "title": "Teklifler ve ödemeler",
        "body": "Bir teklif düzenlendiğinde, o an tanımlanan kapsamı yansıtır ve belirtildiği gibi geçerlidir. Fiyatlar belirtilen para biriminde gösterilir ve sabit bir anlık görüntüye dayanır; kapsam değişiklikleri yeni bir teklif gerektirebilir."
      },
      "acceptableUse": {
        "title": "Kabul edilebilir kullanım",
        "body": "Hizmeti kötüye kullanmamayı, yasa dışı veya yanıltıcı içerik yüklememeyi ve size ait olmayan verilere erişmeye çalışmamayı kabul edersiniz."
      },
      "liability": {
        "title": "Sorumluluk sınırı",
        "body": "Vakanızı koordine ederken özen gösteririz, ancak üçüncü taraf kurum veya sağlayıcıların kararlarından ya da kontrolümüz dışındaki gecikme ve sonuçlardan sorumlu değiliz."
      },
      "changes": {
        "title": "Bu şartlardaki değişiklikler",
        "body": "Hizmet geliştikçe bu şartları güncelleyebiliriz. Önemli değişiklikler yukarıdaki güncelleme tarihine yansıtılır."
      },
      "contact": {
        "title": "İletişim",
        "body": "Bu şartlarla ilgili sorularınızı iletişim sayfasından iletebilirsiniz."
      }
    }
